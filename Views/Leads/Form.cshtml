@model LeadFormVm
@{
    var isNew = Model.LeadId == 0;
    ViewData["Title"] = isNew ? "New Lead" : "Edit Lead";
    var statuses = ((LeadStatus[])ViewBag.Statuses).Select(s => s.ToString());
}
<h4 class="mb-3">@ViewData["Title"]</h4>
<div class="card">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.LeadId)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="LeadId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="LeadName" class="form-label req"></label>
                    <input asp-for="LeadName" class="form-control" maxlength="100" />
                    <span asp-validation-for="LeadName"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control" maxlength="150" />
                    <span asp-validation-for="CompanyName"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="text" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Phone" class="form-label"></label>
                    <input asp-for="Phone" class="form-control" maxlength="10" />
                    <span asp-validation-for="Phone"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Source" class="form-label req"></label>
                    <select asp-for="Source" class="form-select" asp-items="@(new SelectList(LeadSources.All))"></select>
                    <span asp-validation-for="Source"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Status" class="form-label req"></label>
                    <select asp-for="Status" class="form-select" asp-items="@(new SelectList(statuses))"></select>
                    <div class="form-text">Only allowed next statuses are shown.</div>
                    <span asp-validation-for="Status"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Priority" class="form-label req"></label>
                    <select asp-for="Priority" class="form-select" asp-items="@(new SelectList(Enum.GetNames<LeadPriority>()))"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="ExpectedValue" class="form-label req"></label>
                    <div class="input-group"><span class="input-group-text">₹</span>
                        <input asp-for="ExpectedValue" class="form-control" type="number" step="0.01" min="0" /></div>
                    <span asp-validation-for="ExpectedValue"></span>
                </div>
                @if (!User.IsSalesExecutive())
                {
                    <div class="col-md-6">
                        <label asp-for="AssignedTo" class="form-label"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                            <option value="">-- Myself --</option>
                        </select>
                        <span asp-validation-for="AssignedTo"></span>
                    </div>
                }
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
