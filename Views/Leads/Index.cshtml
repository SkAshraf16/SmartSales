@model PagedResult<Lead>
@{
    ViewData["Title"] = "Leads";
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="m-0">Leads</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Lead</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Search lead name, company, email..." /></div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="@(new SelectList(Enum.GetNames<LeadStatus>(), ViewBag.Status?.ToString()))">
            <option value="">All Status</option>
        </select>
    </div>
    @if (!User.IsSalesExecutive())
    {
        <div class="col-md-2">
            <select name="assignedTo" class="form-select" asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Users, "Value", "Text", ViewBag.AssignedTo))">
                <option value="">All Users</option>
            </select>
        </div>
    }
    <div class="col-md-2">
        <select name="sort" class="form-select">
            <option value="newest" selected="@(ViewBag.Sort == "newest")">Newest first</option>
            <option value="oldest" selected="@(ViewBag.Sort == "oldest")">Oldest first</option>
            <option value="name" selected="@(ViewBag.Sort == "name")">Name A-Z</option>
        </select>
    </div>
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-outline-primary flex-fill"><i class="bi bi-search"></i></button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
            <tr><th>Code</th><th>Lead Name</th><th>Company</th><th>Source</th><th>Status</th><th>Priority</th><th>Expected Value</th><th>Assigned To</th><th></th></tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">No leads found.</td></tr>
            }
            @foreach (var l in Model.Items)
            {
                <tr>
                    <td>@l.LeadCode</td>
                    <td><a asp-action="Details" asp-route-id="@l.LeadId">@l.LeadName</a></td>
                    <td>@l.CompanyName</td>
                    <td>@l.Source</td>
                    <td><span class="badge @Fmt.Badge(l.Status.ToString())">@l.Status</span></td>
                    <td><span class="badge @Fmt.Badge(l.Priority.ToString())">@l.Priority</span></td>
                    <td>@Fmt.Inr(l.ExpectedValue)</td>
                    <td>@l.AssignedUser?.FullName</td>
                    <td class="text-nowrap">
                        @if (l.Status != LeadStatus.Converted)
                        {
                            <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        }
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@l.LeadId" method="post" class="d-inline" data-confirm="Delete lead @l.LeadName?">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model" />
