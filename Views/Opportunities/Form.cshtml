@model OpportunityFormVm
@{
    var isNew = Model.OpportunityId == 0;
    ViewData["Title"] = isNew ? "New Opportunity" : "Edit Opportunity";
}
<h4 class="mb-3">@ViewData["Title"]</h4>
<div class="card">
    <div class="card-body">
        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.OpportunityId)" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="OpportunityId" />
            <input type="hidden" asp-for="LeadId" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="OpportunityName" class="form-label req"></label>
                    <input asp-for="OpportunityName" class="form-control" maxlength="150" />
                    <span asp-validation-for="OpportunityName"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerId" class="form-label req"></label>
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                        <option value="">-- Select Customer --</option>
                    </select>
                    <span asp-validation-for="CustomerId"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label req"></label>
                    <div class="input-group"><span class="input-group-text">₹</span>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" /></div>
                    <span asp-validation-for="Amount"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Probability" class="form-label req"></label>
                    <div class="input-group">
                        <input asp-for="Probability" class="form-control" type="number" />
                        <span class="input-group-text">%</span></div>
                    <span asp-validation-for="Probability"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Weighted Amount</label>
                    <input id="weighted" class="form-control" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="Stage" class="form-label req"></label>
                    <select asp-for="Stage" class="form-select" asp-items="@(new SelectList(Enum.GetNames<OpportunityStage>()))"></select>
                    <span asp-validation-for="Stage"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ExpectedCloseDate" class="form-label req"></label>
                    <input asp-for="ExpectedCloseDate" class="form-control" />
                    <span asp-validation-for="ExpectedCloseDate"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Source" class="form-label"></label>
                    <select asp-for="Source" class="form-select" asp-items="@(new SelectList(LeadSources.All))">
                        <option value="">-- Select --</option>
                    </select>
                </div>
                @if (!User.IsSalesExecutive())
                {
                    <div class="col-md-6">
                        <label asp-for="AssignedTo" class="form-label"></label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                            <option value="">-- Myself --</option>
                        </select>
                        <span asp-validation-for="AssignedTo"></span>
                    </div>
                }
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button class="btn btn-primary"><i class="bi bi-save"></i> Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // weighted = amount * probability / 100
        function calcWeighted() {
            var amt = parseFloat($('#Amount').val()) || 0;
            var prob = parseFloat($('#Probability').val()) || 0;
            $('#weighted').val('₹ ' + (amt * prob / 100).toLocaleString('en-IN', { maximumFractionDigits: 0 }));
        }
        $('#Amount, #Probability').on('input', calcWeighted);
        calcWeighted();
    </script>
}
