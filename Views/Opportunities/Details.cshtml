@model Opportunity
@{
    ViewData["Title"] = Model.OpportunityName;
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h4 class="m-0">@Model.OpportunityName <span class="badge @Fmt.Badge(Model.Stage.ToString())">@Model.Stage</span></h4>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.OpportunityId" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        @if (canDelete)
        {
            <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post" data-confirm="Delete this opportunity?">
                <button class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Delete</button>
            </form>
        }
    </div>
</div>

@if (Model.IsActive)
{
    <div class="card mb-3">
        <div class="card-body py-2 d-flex flex-wrap gap-2 align-items-center">
            <span class="small text-muted me-2">Move stage:</span>
            @foreach (var s in Enum.GetValues<OpportunityStage>().Where(s => s != Model.Stage))
            {
                <form asp-action="MoveStage" asp-route-id="@Model.OpportunityId" method="post" class="d-inline"
                      data-confirm="@(s is OpportunityStage.Won or OpportunityStage.Lost ? $"Mark this opportunity as {s}? This cannot be undone." : $"Move to {s}?")">
                    <input type="hidden" name="stage" value="@s" />
                    <button class="btn btn-sm @(s == OpportunityStage.Won ? "btn-success" : s == OpportunityStage.Lost ? "btn-danger" : "btn-outline-secondary")">@s</button>
                </form>
            }
        </div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header">Opportunity Details</div>
            <table class="table table-sm mb-0">
                <tr><th class="ps-3">Customer</th><td><a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@Model.Customer?.CustomerName</a></td></tr>
                @if (Model.Lead != null)
                {
                    <tr><th class="ps-3">From Lead</th><td><a asp-controller="Leads" asp-action="Details" asp-route-id="@Model.LeadId">@Model.Lead.LeadCode</a></td></tr>
                }
                <tr><th class="ps-3">Amount</th><td>@Fmt.Inr(Model.Amount)</td></tr>
                <tr><th class="ps-3">Probability</th><td>@Model.Probability%</td></tr>
                <tr><th class="ps-3">Weighted Amount</th><td>@Fmt.Inr(Model.WeightedAmount)</td></tr>
                <tr><th class="ps-3">Expected Close</th><td>@Fmt.Dt(Model.ExpectedCloseDate)</td></tr>
                <tr><th class="ps-3">Status</th><td>@Model.Status @(Model.ClosedDate != null ? "on " + Fmt.Dt(Model.ClosedDate) : "")</td></tr>
                <tr><th class="ps-3">Source</th><td>@Model.Source</td></tr>
                <tr><th class="ps-3">Owner</th><td>@Model.AssignedUser?.FullName</td></tr>
                <tr><th class="ps-3">Notes</th><td>@Model.Notes</td></tr>
            </table>
        </div>
    </div>
    <div class="col-lg-6">
        <partial name="_History" model="(List<AuditLog>)ViewBag.History" />
    </div>
</div>
