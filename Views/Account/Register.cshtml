@model RegisterVm
@{
    ViewData["Title"] = "Register";
}
<div class="auth-box">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-graph-up-arrow"></i> Smart Sales</h2>
        <p class="text-muted">Create your Sales Executive account</p>
    </div>
    <div class="card">
        <div class="card-body p-4">
            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label req"></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label req"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label req"></label>
                    <input asp-for="Phone" class="form-control" maxlength="10" />
                    <span asp-validation-for="Phone"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label req"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">Min 8 characters with upper case, lower case, number and special character.</div>
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label req"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>
                <button class="btn btn-primary w-100">Register</button>
            </form>
            <p class="text-center small mt-3 mb-0">Already registered? <a asp-action="Login">Login</a></p>
        </div>
    </div>
</div>
