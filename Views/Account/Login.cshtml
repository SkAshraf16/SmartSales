@model LoginVm
@{
    ViewData["Title"] = "Login";
}
<div class="auth-box">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary"><i class="bi bi-graph-up-arrow"></i> Smart Sales</h2>
        <p class="text-muted">Sales &amp; Customer Management System</p>
    </div>
    <div class="card">
        <div class="card-body p-4">
            <h5 class="mb-3">Sign in</h5>
            <form asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <div class="mb-3">
                    <label asp-for="Email" class="form-label req"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label req"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button class="btn btn-primary w-100">Login</button>
            </form>
            <p class="text-center small mt-3 mb-0">New user? <a asp-action="Register">Register here</a></p>
        </div>
    </div>
</div>
