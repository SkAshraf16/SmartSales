@model ResetPasswordVm
@{
    ViewData["Title"] = "Reset Password";
}
<h4 class="mb-3">Reset Password - @Model.Email</h4>
<div class="card" style="max-width:480px">
    <div class="card-body">
        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Email" />
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label req"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <button class="btn btn-primary">Reset Password</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
