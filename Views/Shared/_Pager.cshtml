@model IPaged
@{
    var qs = Context.Request.Query.Where(k => k.Key != "page").ToList();
    string Link(int p)
    {
        var items = qs.Select(k => new KeyValuePair<string, string?>(k.Key, k.Value.ToString())).ToList();
        items.Add(new KeyValuePair<string, string?>("page", p.ToString()));
        return Context.Request.Path + QueryString.Create(items).ToString();
    }
}
<div class="d-flex justify-content-between align-items-center mt-2">
    <span class="small text-muted">Total records: @Model.TotalCount</span>
    @if (Model.TotalPages > 1)
    {
        <ul class="pagination pagination-sm m-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page - 1)">Prev</a></li>
            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Link(i)">@i</a></li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Link(Model.Page + 1)">Next</a></li>
        </ul>
    }
</div>
