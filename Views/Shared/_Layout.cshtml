@{
    var loggedIn = User.Identity?.IsAuthenticated == true;
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var act = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => ctrl == c && (a == null || act == a) ? "active" : "";
    var isAdmin = User.IsInRole(Roles.Admin);
    var isMgr = User.IsInRole(Roles.Manager);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Sales</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (loggedIn)
{
    <nav class="navbar navbar-dark bg-dark px-3 sticky-top">
        <button class="btn btn-outline-light d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sideNav">
            <i class="bi bi-list"></i>
        </button>
        <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Smart Sales</a>
        <div class="ms-auto d-flex align-items-center gap-3 text-white">
            <span class="small d-none d-sm-inline"><i class="bi bi-person-circle"></i> @User.Identity!.Name
                <span class="badge bg-secondary">@(isAdmin ? "Admin" : isMgr ? "Manager" : "Sales Executive")</span></span>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                <button class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right"></i> Logout</button>
            </form>
        </div>
    </nav>
    <div class="d-flex">
        <div class="offcanvas-lg offcanvas-start sidebar bg-body-tertiary border-end" tabindex="-1" id="sideNav">
            <div class="offcanvas-header"><h5>Menu</h5><button class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sideNav"></button></div>
            <div class="offcanvas-body p-0">
                <ul class="nav flex-column w-100 py-2">
                    <li><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                    <li><a class="nav-link @Active("Customers")" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i> Customers</a></li>
                    <li><a class="nav-link @Active("Leads")" asp-controller="Leads" asp-action="Index"><i class="bi bi-person-plus"></i> Leads</a></li>
                    <li><a class="nav-link @(ctrl == "Opportunities" && act != "Pipeline" ? "active" : "")" asp-controller="Opportunities" asp-action="Index"><i class="bi bi-briefcase"></i> Opportunities</a></li>
                    <li><a class="nav-link @Active("Opportunities", "Pipeline")" asp-controller="Opportunities" asp-action="Pipeline"><i class="bi bi-kanban"></i> Sales Pipeline</a></li>
                    <li><a class="nav-link @Active("FollowUps")" asp-controller="FollowUps" asp-action="Index"><i class="bi bi-calendar-check"></i> Follow-Ups</a></li>
                    <li><a class="nav-link @Active("Activities")" asp-controller="Activities" asp-action="Index"><i class="bi bi-telephone"></i> Activities</a></li>
                    <li><a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Reports</a></li>
                    @if (isAdmin || isMgr)
                    {
                        <li class="nav-header">Administration</li>
                        <li><a class="nav-link @Active("Users", "Index")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-gear"></i> Users</a></li>
                        <li><a class="nav-link @Active("Users", "RoleList")" asp-controller="Users" asp-action="RoleList"><i class="bi bi-shield-lock"></i> Roles</a></li>
                        <li><a class="nav-link @Active("Users", "Permissions")" asp-controller="Users" asp-action="Permissions"><i class="bi bi-ui-checks-grid"></i> Permissions</a></li>
                    }
                    @if (isAdmin)
                    {
                        <li><a class="nav-link @Active("AuditLogs")" asp-controller="AuditLogs" asp-action="Index"><i class="bi bi-journal-text"></i> Audit Log</a></li>
                        <li><a class="nav-link" href="/swagger" target="_blank"><i class="bi bi-braces"></i> API Docs</a></li>
                    }
                </ul>
            </div>
        </div>
        <main class="flex-grow-1 p-3 p-md-4 main-area">
            <partial name="_Alerts" />
            @RenderBody()
        </main>
    </div>
    <footer class="text-center small text-muted py-2 border-top">Smart Sales &amp; Customer Management System &copy; @DateTime.Now.Year</footer>
}
else
{
    <main class="container py-5">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
