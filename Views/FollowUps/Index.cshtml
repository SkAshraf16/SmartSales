@model PagedResult<FollowUp>
@{
    ViewData["Title"] = "Follow-Ups";
    var tabs = new[] { ("pending", "Pending"), ("overdue", "Overdue"), ("upcoming", "Upcoming"), ("all", "All") };
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
    DateTime? date = ViewBag.Date;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="m-0">Follow-Ups</h4>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-calendar-plus"></i> Schedule Follow-Up</a>
</div>

<ul class="nav nav-tabs mb-3">
    @foreach (var (key, label) in tabs)
    {
        <li class="nav-item"><a class="nav-link @(ViewBag.View == key ? "active" : "")" href="?view=@key">@label</a></li>
    }
</ul>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="view" value="@ViewBag.View" />
    <div class="col-md-3"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Subject / customer / lead" /></div>
    <div class="col-md-2"><input type="date" name="date" value="@date?.ToString("yyyy-MM-dd")" class="form-control" /></div>
    <div class="col-md-2">
        <select name="status" class="form-select" asp-items="@(new SelectList(Enum.GetNames<FollowUpStatus>(), ViewBag.Status?.ToString()))">
            <option value="">All Status</option>
        </select>
    </div>
    @if (!User.IsSalesExecutive())
    {
        <div class="col-md-3">
            <select name="assignedTo" class="form-select" asp-items="@(new SelectList((IEnumerable<SelectListItem>)ViewBag.Users, "Value", "Text", ViewBag.AssignedTo))">
                <option value="">All Users</option>
            </select>
        </div>
    }
    <div class="col-md-2 d-flex gap-2">
        <button class="btn btn-outline-primary flex-fill"><i class="bi bi-search"></i></button>
        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
            <tr><th>Date</th><th>Subject</th><th>Type</th><th>Related To</th><th>Status</th><th>Assigned To</th><th></th></tr>
            </thead>
            <tbody>
            @if (!Model.Items.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">No follow-ups found.</td></tr>
            }
            @foreach (var f in Model.Items)
            {
                <tr class="@(f.IsOverdue ? "table-danger" : "")">
                    <td>@Fmt.Dt(f.FollowUpDate)</td>
                    <td>@f.Subject</td>
                    <td>@f.FollowUpType</td>
                    <td>
                        @if (f.Customer != null)
                        {
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@f.CustomerId">@f.Customer.CustomerName</a>
                        }
                        else if (f.Lead != null)
                        {
                            <a asp-controller="Leads" asp-action="Details" asp-route-id="@f.LeadId">@f.Lead.LeadName</a> <small class="text-muted">(lead)</small>
                        }
                    </td>
                    <td><span class="badge @(f.IsOverdue ? "bg-danger" : Fmt.Badge(f.Status.ToString()))">@(f.IsOverdue ? "Overdue" : f.Status.ToString())</span></td>
                    <td>@f.AssignedUser?.FullName</td>
                    <td class="text-nowrap">
                        @if (f.Status == FollowUpStatus.Planned)
                        {
                            <form asp-action="SetStatus" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                <input type="hidden" name="status" value="Completed" />
                                <button class="btn btn-sm btn-success" title="Complete"><i class="bi bi-check-lg"></i></button>
                            </form>
                            <form asp-action="SetStatus" asp-route-id="@f.FollowUpId" method="post" class="d-inline" data-confirm="Mark as missed?">
                                <input type="hidden" name="status" value="Missed" />
                                <button class="btn btn-sm btn-outline-warning" title="Missed"><i class="bi bi-x-lg"></i></button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@f.FollowUpId" class="btn btn-sm btn-outline-primary" title="Edit / Reschedule"><i class="bi bi-calendar-event"></i></a>
                        }
                        @if (canDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline" data-confirm="Delete this follow-up?">
                                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<partial name="_Pager" model="Model" />
